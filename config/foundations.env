# Rathsted Foundations — customer configuration
#
# Copy this file to config/customer.env and edit it, or run:
#   make configure
#
# config/customer.env is gitignored and will not be committed.
# This file (foundations.env) is the tracked default — do not edit it directly.

# Registry prefix for your workload images.
# All images must come from this prefix (enforced by the restrict-registries policy).
# Examples:
#   RATHSTED_REGISTRY=ghcr.io/your-org
#   RATHSTED_REGISTRY=registry.example.com/your-team
#   RATHSTED_REGISTRY=localhost
RATHSTED_REGISTRY=docker.io/library

# The image used by the demo workload and supply-chain verification (sign, SBOM, verify).
# Must be under RATHSTED_REGISTRY.
# Set this to an image you own and have signed if you want release verification to pass.
RATHSTED_IMAGE=docker.io/library/nginx:1.29.7-alpine
