# Customer-specific values
# These are sourced by bootstrap.sh and available to kustomize patches

# Customer namespace for workloads
CUSTOMER_NAMESPACE=acme

# Jurisdiction label for the customer namespace (ca, us or fr)
CUSTOMER_JURISDICTION=ca

# Customer image registry (must be in Kyverno allowed list or add a PolicyException)
CUSTOMER_REGISTRY=ghcr.io/acme

# GitOps repo URL for Flux to sync this customer instance
CUSTOMER_GIT_URL=https://github.com/acme/rathsted-customer-acme.git
